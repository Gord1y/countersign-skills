#!/bin/sh
set -eu
LC_ALL=C
export LC_ALL

provider=${1:-}
case $provider in
  claude | codex) ;;
  *)
    echo "usage: harness-hook <claude|codex>, a hook payload on stdin" >&2
    exit 0
    ;;
esac

if ! command -v jq >/dev/null 2>&1; then
  echo "harness-hook: jq not found, walls off" >&2
  exit 0
fi
trap 'exit 0' EXIT

invoked_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd) || invoked_dir=
self=$0
while [ -L "$self" ]; do
  target=$(readlink "$self")
  case $target in
    /*) self=$target ;;
    *) self=$(dirname "$self")/$target ;;
  esac
done
root=$(cd "$(dirname "$self")/.." && pwd -P) || exit 0

adapter=$root/hooks/adapters/$provider.sh
[ -f "$adapter" ] || exit 0
policies=${HARNESS_HOOK_POLICIES:-$root/hooks/policy}
[ -d "$policies" ] || exit 0

start_sweep() {
  saved_path=$PATH
  sweep_path=$PATH${invoked_dir:+:$invoked_dir}
  PATH=$sweep_path
  found=0
  if command -v remove-worktree >/dev/null 2>&1 && command -v prune-branches >/dev/null 2>&1; then
    found=1
  fi
  PATH=$saved_path
  [ "$found" -eq 1 ] || return 0
  common=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  state=$common/countersign
  mkdir -p "$state" 2>/dev/null || return 0
  if [ -n "$(find "$state/sweep.lock" -maxdepth 0 -mmin +2 2>/dev/null)" ]; then
    rmdir "$state/sweep.lock" 2>/dev/null || :
  fi
  mkdir "$state/sweep.lock" 2>/dev/null || return 0
  if [ -f "$state/sweep.stamp" ] && [ -z "$(find "$state/sweep.stamp" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then
    rmdir "$state/sweep.lock" 2>/dev/null || :
    return 0
  fi
  : >"$state/sweep.stamp" 2>/dev/null || {
    rmdir "$state/sweep.lock" 2>/dev/null || :
    return 0
  }
  from=$1
  if [ "$(basename "$common")" = .git ] && [ -d "$(dirname "$common")" ]; then
    from=$(dirname "$common")
  fi
  (
    cd "$from" 2>/dev/null || exit 0
    trap '' HUP
    env PATH="$sweep_path" sh -c 'remove-worktree --landed; prune-branches' >"$state/sweep.log" 2>&1 </dev/null &
  )
  rmdir "$state/sweep.lock" 2>/dev/null || :
}

raw=$(cat)
adapted=$(printf '%s' "$raw" | sh "$adapter" 2>/dev/null) || exit 0
[ -n "$adapted" ] || exit 0

event=$(printf '%s' "$adapted" | jq -c '
  def text: if type == "string" then . else "" end;
  def lexical:
    split("/")
    | reduce .[] as $part ([];
        if $part == "" or $part == "." then .
        elif $part == ".." then .[:-1]
        else . + [$part] end)
    | "/" + join("/");
  (.cwd | text) as $cwd
  | select((.event | IN("pre_tool", "stop")) and ($cwd | startswith("/")))
  | {
      provider: (.provider | text),
      event: .event,
      tool: (if (.tool | IN("shell", "edit", "other", "none")) then .tool else "other" end),
      tool_name: (.tool_name | text),
      command: (.command | text),
      paths: ([.paths[]? | select(type == "string" and . != "")
        | (if startswith("/") then . else $cwd + "/" + . end) | lexical] | unique),
      cwd: $cwd,
      session_id: (.session_id | text),
      subagent: (.subagent == true),
      stop_hook_active: (.stop_hook_active == true)
    }' 2>/dev/null) || exit 0
[ -n "$event" ] || exit 0

if [ "$(printf '%s' "$event" | jq -r '.event == "stop" and (.subagent | not)')" = true ]; then
  start_sweep "$(printf '%s' "$event" | jq -r '.cwd')" || :
fi

if [ "$(printf '%s' "$event" | jq -r '.event == "stop" and .stop_hook_active')" = true ]; then
  exit 0
fi

kind=$(printf '%s' "$event" | jq -r '.event')

for policy in "$policies"/*.sh; do
  [ -f "$policy" ] || continue
  status=0
  reason=$(printf '%s\n' "$event" | sh "$policy" 2>/dev/null) || status=$?
  case $status in
    0) ;;
    10)
      case $reason in
        *[![:space:]]*) ;;
        *) reason="blocked by the $(basename "$policy" .sh) hook policy" ;;
      esac
      if [ "$kind" = stop ]; then
        jq -n --arg reason "$reason" '{decision: "block", reason: $reason}'
      else
        jq -n --arg reason "$reason" '{hookSpecificOutput: {hookEventName: "PreToolUse", permissionDecision: "deny", permissionDecisionReason: $reason}}'
      fi
      exit 0
      ;;
    *) echo "harness-hook: $(basename "$policy") exited $status, allowed" >&2 ;;
  esac
done
exit 0

#!/bin/sh
set -eu
LC_ALL=C
export LC_ALL

usage='usage: gate (runs the "gate:" line under "## Gates" in CLAUDE.md or AGENTS.md at the repo root, then stamps the working tree)'

if [ $# -gt 0 ]; then
  case $1 in
    -h | --help)
      echo "$usage"
      exit 0
      ;;
    *)
      echo "$usage" >&2
      exit 2
      ;;
  esac
fi

slot_count=${COUNTERSIGN_GATE_SLOTS-2}
case $slot_count in
  '' | *[!0-9]* | 0*)
    echo "gate: COUNTERSIGN_GATE_SLOTS must be a positive integer, got '$slot_count'" >&2
    exit 2
    ;;
esac

if ! top=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "gate: not inside a git repository" >&2
  exit 2
fi
git_dir=$(git -C "$top" rev-parse --absolute-git-dir)
common=$(git -C "$top" rev-parse --path-format=absolute --git-common-dir)

tree_hash() {
  index=$(mktemp "${TMPDIR:-/tmp}/gate-index.XXXXXX") || return 1
  trap 'rm -f "$index"' EXIT
  trap 'exit 1' INT TERM
  if [ -e "$git_dir/index" ]; then
    cp -p "$git_dir/index" "$index" || return 1
  else
    rm -f "$index"
  fi
  GIT_INDEX_FILE=$index git -C "$top" add -A -- . >/dev/null 2>&1 || return 1
  GIT_INDEX_FILE=$index git -C "$top" rm -r -q -f --cached --ignore-unmatch -- .claude/worktrees >/dev/null 2>&1 || return 1
  tree=$(GIT_INDEX_FILE=$index git -C "$top" write-tree 2>/dev/null) || return 1
  [ -n "$tree" ] || return 1
  printf '%s\n' "$tree"
}

gate_line() {
  tr -d '\r' <"$1" | awk '
    /^```/ { fence = !fence; next }
    fence { next }
    /^## / { in_gates = ($0 ~ /^## Gates[[:space:]]*$/); next }
    /^# / { in_gates = 0; next }
    in_gates && /^gate:[[:space:]]*[^[:space:]]/ {
      line = $0
      sub(/^gate:[[:space:]]*/, "", line)
      sub(/[[:space:]]+$/, "", line)
      print line
      exit
    }'
}

instruction_file=
name=CLAUDE.md
if [ -e "$top/CLAUDE.md" ]; then
  instruction_file=$top/CLAUDE.md
elif [ -e "$top/AGENTS.md" ]; then
  instruction_file=$top/AGENTS.md
  name=AGENTS.md
fi
command=
if [ -n "$instruction_file" ]; then
  command=$(gate_line "$instruction_file")
fi
if [ -z "$command" ]; then
  echo "gate: $name has no gate line. Add one line under \"## Gates\" in $name, in the form \"gate: <command that runs all of the repo's gates>\"." >&2
  exit 3
fi

mkdir -p "$git_dir/countersign" || {
  echo "gate: cannot write $git_dir/countersign" >&2
  exit 2
}

held_lock=
held_slot=
release() {
  [ -z "$held_lock" ] || rm -rf "$held_lock"
  [ -z "$held_slot" ] || rm -rf "$held_slot"
}
trap release EXIT
trap 'exit 1' INT TERM

take() {
  mkdir "$1" 2>/dev/null || return 1
  printf '%s\n' "$$" >"$1/pid"
}

holder_pid() {
  cat "$1/pid" 2>/dev/null || true
}

holder_dead() {
  dead_pid=$(holder_pid "$1")
  case $dead_pid in
    '')
      [ -n "$(find "$1" -maxdepth 0 -mmin +1 2>/dev/null)" ]
      return
      ;;
    *[!0-9]*) return 0 ;;
  esac
  kill_error=$(kill -0 "$dead_pid" 2>&1) && return 1
  case $kill_error in
    *"No such process"*) return 0 ;;
  esac
  return 1
}

reap() {
  reaped=$1.dead.$$
  mv "$1" "$reaped" 2>/dev/null || return 0
  rm -rf "$reaped"
}

lock=$git_dir/countersign/gate.lock
waited_for_tree=
announced=
while ! take "$lock"; do
  if holder_dead "$lock"; then
    reap "$lock"
    continue
  fi
  if [ -z "$announced" ]; then
    echo "gate: another gate is running in this tree (pid $(holder_pid "$lock")); waiting for it. Do not start another gate."
    announced=yes
    waited_for_tree=yes
  fi
  sleep 2
done
held_lock=$lock

if [ -n "$waited_for_tree" ]; then
  if ! waited_hash=$(tree_hash); then
    echo "gate: could not hash the working tree" >&2
    exit 2
  fi
  if [ -f "$common/countersign/gate/$waited_hash" ]; then
    echo "gate: the tree already passed while this gate waited, stamped tree $(printf '%s' "$waited_hash" | cut -c1-12)"
    exit 0
  fi
fi

slot_root=${XDG_CACHE_HOME:-${HOME:-}/.cache}/countersign/gate-slots
if mkdir -p "$slot_root" 2>/dev/null && [ -w "$slot_root" ]; then
  slot_announced=
  while [ -z "$held_slot" ]; do
    slot_index=1
    reaped_any=
    while [ "$slot_index" -le "$slot_count" ]; do
      slot=$slot_root/slot-$slot_index
      if take "$slot"; then
        held_slot=$slot
        break
      fi
      if holder_dead "$slot"; then
        reap "$slot"
        reaped_any=yes
      fi
      slot_index=$((slot_index + 1))
    done
    [ -z "$held_slot" ] || break
    [ -z "$reaped_any" ] || continue
    if [ -z "$slot_announced" ]; then
      echo "gate: $slot_count gates are running on this machine; waiting for a slot."
      slot_announced=yes
    fi
    sleep 2
  done
else
  echo "gate: cannot create $slot_root; running without the machine-wide cap of $slot_count gates." >&2
fi

if ! before=$(tree_hash); then
  echo "gate: could not hash the working tree" >&2
  exit 2
fi

echo "gate: running $command"
log=$git_dir/countersign/gate.log
status=0
(cd "$top" && sh -c "$command" </dev/null) >"$log" 2>&1 || status=$?
tail -n 60 "$log"

if [ "$status" -ne 0 ]; then
  echo "gate: failed with exit $status. Full output: $log" >&2
  exit 1
fi

if ! after=$(tree_hash); then
  echo "gate: could not hash the working tree" >&2
  exit 2
fi
if [ "$after" != "$before" ]; then
  echo "gate: passed, but the working tree changed while it ran, so it is not stamped. Ignore or commit what the gate writes, then run gate again." >&2
  exit 4
fi

stamp_dir=$common/countersign/gate
if ! mkdir -p "$stamp_dir" ||
  ! printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$command" >"$stamp_dir/$after.$$" ||
  ! mv "$stamp_dir/$after.$$" "$stamp_dir/$after"; then
  rm -f "$stamp_dir/$after.$$"
  echo "gate: cannot write $stamp_dir" >&2
  exit 2
fi
echo "gate: passed, stamped tree $(printf '%s' "$after" | cut -c1-12)"

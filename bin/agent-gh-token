#!/bin/sh
set -eu

config="${AGENT_GH_APPS:-${XDG_CONFIG_HOME:-$HOME/.config}/countersign/profile/agent-gh-apps.tsv}"
api="${AGENT_GH_API:-https://api.github.com}"

usage() {
  echo "usage: agent-gh-token [--owner <owner>] <command> [args...]" >&2
  echo "runs <command> with GH_TOKEN set to a 1h installation token of the GitHub App mapped to the owner" >&2
  echo "in $config (owner<TAB>app id<TAB>private key path); the owner defaults to origin's" >&2
  exit 2
}

die() {
  echo "agent-gh-token: $1" >&2
  exit 1
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

base64url() {
  openssl base64 -A | tr '+/' '-_' | tr -d '='
}

owner=
repo=
if [ "${1:-}" = --owner ]; then
  [ $# -ge 2 ] || usage
  owner=$2
  shift 2
fi
[ $# -ge 1 ] || usage

if [ -z "$owner" ]; then
  url=$(git remote get-url origin 2>/dev/null) || die "not in a git repo with an origin; pass --owner"
  case $url in
    *://*)
      rest=${url#*://}
      path=${rest#*/}
      ;;
    *@*:*)
      path=${url#*:}
      ;;
    *)
      die "cannot read the owner from origin $url; pass --owner"
      ;;
  esac
  owner=${path%%/*}
  repo=${path#*/}
  repo=${repo%/}
  repo=${repo%.git}
fi

[ -f "$config" ] || die "$config does not exist; add a line: owner<TAB>app id<TAB>private key path"

tab=$(printf '\t')
app_id=
key=
while IFS=$tab read -r row_owner row_app row_key || [ -n "$row_owner" ]; do
  [ -n "$row_owner" ] || continue
  if [ "$(lowercase "$row_owner")" = "$(lowercase "$owner")" ]; then
    app_id=$row_app
    key=$row_key
    break
  fi
done <"$config"

[ -n "$app_id" ] || die "no GitHub App for $owner in $config"
case $key in
  \~/*) key=$HOME/${key#\~/} ;;
esac
[ -f "$key" ] || die "the private key for $owner is missing at $key"
if git -C "$(dirname "$key")" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  die "the private key for $owner sits inside a git work tree at $key; move it out of every repo"
fi

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | base64url)
claims=$(printf '{"iat":%s,"exp":%s,"iss":"%s"}' "$((now - 60))" "$((now + 540))" "$app_id" | base64url)
signature=$(printf '%s.%s' "$header" "$claims" | openssl dgst -sha256 -sign "$key" -binary | base64url) ||
  die "could not sign with the key at $key"
jwt="$header.$claims.$signature"

github() {
  printf 'header = "Authorization: Bearer %s"\n' "$jwt" |
    curl -fsS -K - -X "$1" -H "Accept: application/vnd.github+json" \
      -H "X-GitHub-Api-Version: 2022-11-28" ${3:+-d "$3"} "$api$2"
}

installation=$(github GET "/orgs/$owner/installation" 2>/dev/null) ||
  installation=$(github GET "/users/$owner/installation" 2>/dev/null) ||
  die "the app $app_id is not installed on $owner"
installation_id=$(printf '%s' "$installation" | jq -r '.id')

body=
if [ -n "$repo" ]; then
  body=$(jq -cn --arg repo "$repo" '{repositories: [$repo]}')
fi
response=$(github POST "/app/installations/$installation_id/access_tokens" "$body") ||
  die "GitHub refused an installation token for $owner${repo:+/$repo}"
token=$(printf '%s' "$response" | jq -r '.token // empty')
[ -n "$token" ] || die "GitHub returned no token for $owner"

GH_TOKEN=$token
export GH_TOKEN
exec "$@"

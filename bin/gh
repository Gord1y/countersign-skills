#!/bin/sh
set -eu

find_real_gh() {
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    candidate="${dir:-.}/gh"
    if [ -f "$candidate" ] && [ -x "$candidate" ] && ! cmp -s "$candidate" "$0"; then
      IFS=$old_ifs
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  IFS=$old_ifs
  return 1
}

lowercase() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

real=$(find_real_gh) || {
  echo "gh: no gh found on PATH besides this wrapper" >&2
  exit 127
}

passthrough() {
  exec "$real" "$@"
}

[ -z "${GH_TOKEN:-}" ] || passthrough "$@"
[ "${1:-}" != auth ] || [ "${2:-}" = git-credential ] || passthrough "$@"

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/countersign/profile"
map_file="$config_dir/gh-accounts.tsv"
apps_file="$config_dir/agent-gh-apps.tsv"
[ -f "$map_file" ] || [ -f "$apps_file" ] || passthrough "$@"
agent_session=
if [ -n "${CLAUDECODE:-}${CODEX_THREAD_ID:-}" ] && [ -f "$apps_file" ]; then
  agent_session=yes
fi

valid_part() {
  case $1 in
    '' | -*) return 1 ;;
  esac
  return 0
}

parse_repo() {
  case $1 in
    */*/*/*) return 1 ;;
    */*/*)
      host=${1%%/*}
      path=${1#*/}
      ;;
    */*)
      host=github.com
      path=$1
      ;;
    *) return 1 ;;
  esac
  valid_part "$host" && valid_part "${path%%/*}" && valid_part "${path#*/}"
}

parse_positional() {
  case $1 in
    http://* | https://*)
      rest=${1#*://}
      [ "${rest#*/}" != "$rest" ] || return 1
      authority=${rest%%/*}
      host=${authority#*@}
      host=${host%%:*}
      path=${rest#*/}
      ;;
    git@*:*)
      rest=${1#git@}
      host=${rest%%:*}
      path=${rest#*:}
      ;;
    *)
      parse_repo "$1"
      return
      ;;
  esac
  path=${path%/}
  path=${path%.git}
  case $path in
    */*/*) return 1 ;;
    */*) ;;
    *) return 1 ;;
  esac
  valid_part "$host" && valid_part "${path%%/*}" && valid_part "${path#*/}"
}

reject_target() {
  if [ -n "$agent_session" ]; then
    echo "gh: cannot read a repo from \"$1\"; pass -R OWNER/REPO" >&2
    exit 1
  fi
  shift
  passthrough "$@"
}

explicit=
flag_seen=
want_value=
for arg in "$@"; do
  if [ -n "$want_value" ]; then
    explicit=$arg
    want_value=
    continue
  fi
  case $arg in
    --) break ;;
    -R | --repo)
      flag_seen=$arg
      want_value=yes
      ;;
    -R?*)
      flag_seen=$arg
      explicit=${arg#-R}
      ;;
    --repo=*)
      flag_seen=$arg
      explicit=${arg#--repo=}
      ;;
  esac
done
if [ -n "$flag_seen" ] && [ -z "$explicit" ]; then
  reject_target "$flag_seen" "$@"
fi

positional=
if [ -z "$explicit" ] && [ "${1:-}" = repo ]; then
  position=0
  for arg in "$@"; do
    position=$((position + 1))
    [ "$position" -gt 2 ] || continue
    case $arg in
      --) break ;;
      -*) continue ;;
    esac
    if parse_positional "$arg"; then
      positional=$arg
      break
    fi
  done
fi

have_target=
if [ -n "$explicit" ]; then
  parse_repo "$explicit" || reject_target "$explicit" "$@"
  have_target=yes
elif [ -n "$positional" ] && parse_positional "$positional"; then
  have_target=yes
elif [ -n "${GH_REPO:-}" ]; then
  parse_repo "$GH_REPO" || reject_target "$GH_REPO" "$@"
  have_target=yes
fi

if [ -z "$have_target" ]; then
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || passthrough "$@"
  url=$(git remote get-url origin 2>/dev/null) || passthrough "$@"
  case $url in
    *://*)
      rest=${url#*://}
      authority=${rest%%/*}
      path=${rest#*/}
      host=${authority#*@}
      host=${host%%:*}
      ;;
    *@*:*)
      rest=${url#*@}
      host=${rest%%:*}
      path=${rest#*:}
      ;;
    *)
      passthrough "$@"
      ;;
  esac
fi

[ "$(lowercase "$host")" = github.com ] || passthrough "$@"
owner=${path%%/*}
[ -n "$owner" ] || passthrough "$@"
repo=${path#*/}
repo=${repo%/}
repo=${repo%.git}
[ -n "$repo" ] && [ "$repo" != "$path" ] || passthrough "$@"
wanted=$(lowercase "$owner")

tab=$(printf '\t')

if [ -n "$agent_session" ]; then
  app_matched=
  while IFS=$tab read -r app_owner _ || [ -n "$app_owner" ]; do
    [ -n "$app_owner" ] || continue
    if [ "$(lowercase "$app_owner")" = "$wanted" ]; then
      app_matched=yes
      break
    fi
  done <"$apps_file"
  if [ -n "$app_matched" ]; then
    if ! command -v agent-gh-token >/dev/null 2>&1; then
      echo "gh: $owner is mapped to a GitHub App in $apps_file, but agent-gh-token is not on PATH; run install.sh" >&2
      exit 1
    fi
    exec agent-gh-token --repo "$owner/$repo" "$real" "$@"
  fi
fi

[ -f "$map_file" ] || passthrough "$@"

account=
while IFS=$tab read -r map_owner map_account || [ -n "$map_owner" ]; do
  [ -n "$map_owner" ] || continue
  if [ "$(lowercase "$map_owner")" = "$wanted" ]; then
    account=$map_account
    break
  fi
done <"$map_file"

[ -n "$account" ] || passthrough "$@"

token=$("$real" auth token -u "$account" 2>/dev/null) || token=
if [ -z "$token" ]; then
  echo "gh: no token for account $account, mapped from $owner in $map_file; run gh where it can read its keyring, or sign the account in with: gh auth login" >&2
  exit 1
fi

GH_TOKEN=$token
export GH_TOKEN
exec "$real" "$@"

#!/bin/sh
set -eu

usage() {
  echo "usage: brief-lint <file> [--base-url <url>] [--allow <word>]..." >&2
  exit 2
}

file=""
base_url=""
allowed="|"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --base-url)
      [ "$#" -ge 2 ] || usage
      base_url=$2
      shift 2
      ;;
    --allow)
      [ "$#" -ge 2 ] || usage
      allowed="$allowed$2|"
      shift 2
      ;;
    -*)
      usage
      ;;
    *)
      [ -z "$file" ] || usage
      file=$1
      shift
      ;;
  esac
done

[ -n "$file" ] || usage
if [ ! -f "$file" ] || [ ! -r "$file" ]; then
  echo "brief-lint: cannot read $file" >&2
  exit 2
fi

export LC_ALL=C

BRIEF_FILE=$file awk -v base="$base_url" -v allowed="$allowed" '
function normalize(url) {
  gsub(/[.,;:!?)}\]>*"`\047]+$/, "", url)
  sub(/\/$/, "", url)
  return url
}
function is_allowed(word) {
  return tolower(word) in allow_set
}
function clean_token(token) {
  gsub(/^[*]+/, "", token)
  sub(/:[0-9]+$/, "", token)
  gsub(/[.,;:!?*]+$/, "", token)
  return token
}
function is_path(token,    lowered, parts, count, ext) {
  lowered = tolower(token)
  if (token ~ /^\.\.?\// || token ~ /^~\//) {
    return 1
  }
  if (token ~ /^\/[A-Za-z]/) {
    return 1
  }
  if (lowered ~ /^[a-z0-9_.-]+\.(ts|tsx|js|jsx|mjs|cjs|json|md|sh|py|rb|go|rs|css|scss|html|yml|yaml|toml|sql|swift|kt)$/) {
    return 1
  }
  if (index(token, "/") > 0 && token ~ /[A-Za-z0-9_.-]*\/[A-Za-z0-9_.\/-]*\.[A-Za-z0-9]+$/) {
    count = split(token, parts, ".")
    ext = parts[count]
    if (length(ext) >= 2 && length(ext) <= 5 && ext ~ /[A-Za-z]/) {
      return 1
    }
  }
  return 0
}
function is_attribute_token(token,    name) {
  if (token !~ /^(data|aria)-[a-z]/) {
    return 0
  }
  name = token
  sub(/[^a-z-].*$/, "", name)
  return name in known_attribute
}
function is_selector_token(token) {
  if (token ~ /^#[A-Za-z]/ || token ~ /^\.[A-Za-z]/) {
    return 1
  }
  return is_attribute_token(token)
}
function report(rule) {
  printf "%s:%d: %s: %s\n", display, NR, rule, $0
  found = 1
}
BEGIN {
  display = ENVIRON["BRIEF_FILE"]
  base = normalize(base)
  entry_count = split(allowed, entries, "|")
  for (e = 1; e <= entry_count; e++) {
    part_count = split(entries[e], parts, " ")
    for (p = 1; p <= part_count; p++) {
      allow_set[tolower(parts[p])] = 1
    }
  }
  split("component endpoint prop props mutation regex null undefined repo refactor codebase frontend backend", code_words, " ")
  for (i in code_words) {
    is_code_word[code_words[i]] = 1
  }
  split("data-testid data-test data-cy data-qa data-id aria-label aria-labelledby aria-describedby aria-hidden aria-expanded aria-controls aria-selected aria-checked aria-disabled aria-live aria-current aria-pressed", attributes, " ")
  for (i in attributes) {
    known_attribute[attributes[i]] = 1
  }
  found = 0
}
{
  sub(/\r$/, "")
  rest = $0
  gsub(/\342\200\230|\342\200\231|\342\200\234|\342\200\235|\302\240/, " ", rest)

  bad_url = 0
  scan = rest
  while (match(scan, /https?:\/\/[^ \t]+/)) {
    url = substr(scan, RSTART, RLENGTH)
    if (base == "" || normalize(url) != base) {
      bad_url = 1
    }
    scan = substr(scan, 1, RSTART - 1) " " substr(scan, RSTART + RLENGTH)
  }
  rest = scan
  if (match(rest, /(localhost|127\.0\.0\.1):[0-9]+/)) {
    bad_url = 1
  }

  has_code = index($0, "`") > 0

  has_path = 0
  has_selector = 0
  if (rest ~ /\[[A-Za-z_-]+=/ || rest ~ /(^|[^A-Za-z0-9_-])(data|aria)-[A-Za-z-]+[=\]]/) {
    has_selector = 1
  }
  token_count = split(rest, tokens, /[][ \t()<>"`\047]+/)
  for (t = 1; t <= token_count; t++) {
    token = clean_token(tokens[t])
    if (token == "") {
      continue
    }
    if (is_allowed(token)) {
      continue
    }
    if (is_path(token)) {
      has_path = 1
    }
    if (is_selector_token(token)) {
      has_selector = 1
    }
  }

  has_identifier = 0
  has_code_word = 0
  call_scan = rest
  while (match(call_scan, /[A-Za-z0-9_]+\(\)/)) {
    call_word = substr(call_scan, RSTART, RLENGTH - 2)
    if (!is_allowed(call_word)) {
      has_identifier = 1
    }
    call_scan = substr(call_scan, RSTART + RLENGTH)
  }
  word_line = rest
  gsub(/[^A-Za-z0-9_]+/, " ", word_line)
  word_count = split(word_line, words, " ")
  for (w = 1; w <= word_count; w++) {
    word = words[w]
    if (is_allowed(word)) {
      continue
    }
    if (word ~ /[a-z][A-Z]/ || word ~ /[A-Z][a-z0-9]+[A-Z]/ || word ~ /[A-Za-z0-9]_[A-Za-z0-9]/) {
      has_identifier = 1
    }
    if (tolower(word) in is_code_word) {
      has_code_word = 1
    }
  }

  has_click_path = 0
  if ($0 !~ /^> /) {
    if ($0 ~ /[^ ] > [^ ]/ || $0 ~ /[A-Za-z]>[A-Za-z]/) {
      has_click_path = 1
    }
    if (index($0, "→") > 0 || index($0, "->") > 0 || index($0, "=>") > 0 || index($0, "»") > 0 || index($0, ">>") > 0 || index($0, "›") > 0) {
      has_click_path = 1
    }
  }

  if (has_code) report("code")
  if (has_path) report("path")
  if (bad_url) report("url")
  if (has_selector) report("selector")
  if (has_identifier) report("identifier")
  if (has_click_path) report("click-path")
  if (has_code_word) report("code-word")
}
END {
  exit found
}
' <"$file"
